{
  "name": "gitforge",
  "version": "0.2.0",
  "private": true,
  "description": "Agent-safe contribution infrastructure for GitHub and MCP workflows",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx 'test/**/*.test.ts'",
    "start": "node dist/apps/mcp-server/src/index.js",
    "dev": "tsx apps/mcp-server/src/index.ts",
    "start:http": "node dist/apps/http-server/src/index.js",
    "dev:http": "tsx apps/http-server/src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@octokit/rest": "^22.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
